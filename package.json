{
  "name": "confluence-autolinks",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.13.0",
  "scripts": {
    "build": "vite build",
    "check": "pnpm format:check && pnpm lint:ci && pnpm typecheck && pnpm test && pnpm build",
    "dev": "vite build --watch",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "icons:generate": "node scripts/generate-icons.mjs",
    "lint": "oxlint . --import-plugin --tsconfig ./tsconfig.json",
    "lint:ci": "oxlint . --import-plugin --tsconfig ./tsconfig.json --deny-warnings",
    "lint:fix": "oxlint . --import-plugin --tsconfig ./tsconfig.json --fix",
    "package": "pnpm build && cd dist && zip -r -FS ../package.zip .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@types/chrome": "0.3.5",
    "@types/node": "25.9.9",
    "jsdom": "30.1.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "terser": "5.51.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
